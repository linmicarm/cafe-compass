{
  "name": "cafe-compass",
  "version": "1.0.0",
  "description": "A café discovery app for finding cozy, wifi-friendly workspaces. Filter by vibe, wifi quality, noise level, and outlet availability.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "db:setup": "node src/db/setup.js"
  },
  "dependencies": {

cat > src/db/pool.js << 'EOF'
import pg from 'pg';
import 'dotenv/config';

const { Pool } = pg;

// DATABASE_URL, e.g. postgres://user:pass@localhost:5432/cafe_compass
// Managed Postgres (Render, Neon, etc.) requires SSL; local dev does not.
const useSSL = process.env.PGSSL === 'require' || process.env.NODE_ENV === 'production';

export const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: useSSL ? { rejectUnauthorized: false } : false,
});

export const query = (text, params) => pool.query(text, params);
